# Public site
NEXT_PUBLIC_SITE_URL=https://solphia.io
NEXT_PUBLIC_NETWORK=mainnet-beta

# Treasury that receives 0.1 SOL / 30d subscriptions. Public address only.
# Default in code is 2jNYVsfptvRLrg8V8AoLMVq6pnmpi7BHVo7Hsx5PTpma if this is blank.
SOLPHIA_TREASURY=2jNYVsfptvRLrg8V8AoLMVq6pnmpi7BHVo7Hsx5PTpma
# Optional hot key so cron can harvest leftover claims. Must match the displayed treasury.
# JSON [64 bytes] or base64 of the secret. Never commit it. Prefer the in-house project wallet.
# TREASURY_SECRET=
# Optional. Secret for the airdrop/foundation wallet so Founders Circle claims can send.
# Must match the airdrop wallet. Never commit it.
# AIRDROP_SECRET=

# Paper vs live. Set true so a connected Phantom can flip to real SOL↔xStock swaps.
LIVE_TRADING=true
NEXT_PUBLIC_LIVE_TRADING=true
PAPER_STARTING_USD=1000

# Jupiter Swap V2 (portal.jup.ag). Server-only. Used by /api/jup/order + /execute.
# Without this key, orders still work via api.jup.ag then lite Ultra v1. Put the key on Vercel for rate limits.
JUPITER_API_KEY=
# Integrator 1% (100 bps). Public referral account (not a secret). Also hardcoded as
# the default in src/lib/jup/swapV2.ts. Create SOL + USDC referral token accounts at
# https://referral.jup.ag or Jupiter keeps the fee. Jupiter keeps 20% of the 1%.
JUPITER_REFERRAL_ACCOUNT=rT14BqLLxVXiyK3ZeoeK8kCuU9sCQHVYUCXuBjeG8cV

# Optional. When set, RPC + enhanced APIs switch to Helius (funding-graph rug clock).
# Never commit the real key. Put it in .env.local and Vercel env.
HELIUS_API_KEY=

# SpaceXAI / xAI — Solphia's voice. Server-side only.
XAI_API_KEY=

# Pinata IPFS — launch art. JWT from pinata.cloud → API Keys. Never commit real values.
PINATA_JWT=
PINATA_API_KEY=
PINATA_API_SECRET=
# PINATA_GATEWAY=https://your-gateway.mypinata.cloud/ipfs

# Email / Google accounts. Session cookies are signed with ADMIN_SECRET.
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
# (Web application). OAuth consent screen first if prompted.
# Authorized JavaScript origins:
#   https://solphia.io
#   http://localhost:3100
# Authorized redirect URIs:
#   https://solphia.io/api/auth/google/callback
#   http://localhost:3100/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Cloudflare Turnstile bot check on signup/login.
# Without these, signup uses a signed math challenge instead.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=

# Admin dashboard. Generate a long random string.
ADMIN_SECRET=change-me-to-a-64-char-random
FOUNDER_WALLETS=
CRON_SECRET=change-me-cron

# In-house OTP mail. Sent FROM Solphia's inbox, never Gmail.
# AGENTMAIL_API_KEY=
# AGENTMAIL_INBOX=solphia@agentmail.to
MAIL_FROM=Solphia <solphia@agentmail.to>
# Optional non-Gmail SMTP only. Do not set smtp.gmail.com.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Solphia <hello@solphia.io>
# Optional Resend if AgentMail is not used.
# RESEND_API_KEY=
ALERT_FROM_NAME=Solphia

# Data directory override (local only). Vercel /tmp is wiped on every cold start.
DATA_DIR=

# Durable state so treasury, seats, and paper survive Vercel deploys.
# Create an Upstash Redis (free) in the Vercel dashboard → Storage, then:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Or Vercel Blob:
# BLOB_READ_WRITE_TOKEN=
