# Public site
NEXT_PUBLIC_SITE_URL=https://solphia.io
NEXT_PUBLIC_NETWORK=mainnet-beta

# Treasury that receives 0.15 SOL / month subscriptions. Never a private key.
SOLPHIA_TREASURY=REPLACE_WITH_YOUR_SOLANA_ADDRESS

# Paper vs live. Keep false until Helius is wired and the book is proven.
LIVE_TRADING=false
PAPER_STARTING_USD=1000

# Optional. When set, RPC + enhanced APIs switch to Helius. Public feeds still work without it.
HELIUS_API_KEY=

# SpaceXAI / xAI — Solphia's voice. Server-side only.
XAI_API_KEY=

# Admin dashboard. Generate a long random string.
ADMIN_SECRET=change-me-to-a-64-char-random
CRON_SECRET=change-me-cron

# Email (optional). Without these, alerts land in the in-app outbox + admin preview.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Solphia <alerts@solphia.io>
ALERT_FROM_NAME=Solphia

# Data directory override (Vercel uses /tmp)
DATA_DIR=
